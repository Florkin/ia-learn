# Copy this file to .env and set your first name. Everything else has a working default.

# Folder name under learners/ (lowercase, no spaces).
LEARNER=

# Chat model used by every module. Default: Ollama on this machine.
# CHAT_BASE_URL=http://localhost:11434/v1
# CHAT_API_KEY=ollama
# CHAT_MODEL=granite4.1:3b

# Embedding model. Default: Ollama on this machine.
# EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_API_KEY=ollama
# EMBED_MODEL=bge-m3

# Machine too small for Ollama? Point both at OpenRouter instead:
# CHAT_BASE_URL=https://openrouter.ai/api/v1
# CHAT_API_KEY=sk-or-...
# CHAT_MODEL=openai/gpt-6-luna
# EMBED_BASE_URL=https://openrouter.ai/api/v1
# EMBED_API_KEY=sk-or-...
# EMBED_MODEL=baai/bge-m3

# Module 10 (hosted models): your OpenRouter key and the models to compare.
OPENROUTER_API_KEY=
# HOSTED_MODELS=openai/gpt-6-luna,qwen/qwen3.7-flash,anthropic/claude-sonnet-5.5

# Module 14 (fine-tuning): mlx on Apple Silicon, peft elsewhere. Override to compare both.
# FINETUNE_BACKEND=peft
# Training steps. 200 by default. On a machine without a graphics card, 100 halves the wait.
# FINETUNE_ITERS=100
